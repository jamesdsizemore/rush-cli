{
  "rush-continuation": {
    "PreInvocation": [{"type": "command", "command": "@RUSH_BINARY_SH@ agent hook antigravity --event PreInvocation", "timeout": 5}],
    "PostToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "@RUSH_BINARY_SH@ agent hook antigravity --event PostToolUse", "timeout": 5}]}],
    "Stop": [{"type": "command", "command": "@RUSH_BINARY_SH@ agent hook antigravity --event Stop", "timeout": 10}]
  }
}
